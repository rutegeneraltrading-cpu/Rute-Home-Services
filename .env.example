# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App
NEXT_PUBLIC_APP_URL=https://www.rute.co.za
NEXT_PUBLIC_GA_ID=''
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Contentful
CONTENTFUL_SPACE_ID=your_space_id
CONTENTFUL_ACCESS_TOKEN=your_access_token
CONTENTFUL_ENVIRONMENT=master

# Email
EMAIL_AUTH_ALERTS_ENABLED=true
ADMIN_FROM='admin@rute.co.za'
DEFAULT_FROM='no-reply@rute.co.za'
RESEND_API_KEY=your_resend_api_key_here

# PayFast
PAYFAST_MARCHANT_ID=your_payfast_merchant_id
PAYFAST_MARCHANT_KEY=your_payfast_merchant_key
PAYFAST_PASSPHRASE=your_payfast_passphrase
PAYFAST_DEBUG_SIGNATURE=false
PAYFAST_SIGNATURE_MODE=with-passphrase
PAYFAST_SIGNATURE_ORDER=alphabetical
PAYFAST_NOTIFY_URL=https://your-public-domain/api/payments/payfast/webhook
PAYFAST_SKIP_SIGNATURE_VALIDATION=false

# Twilio WhatsApp
WHATSAPP_NOTIFICATIONS_ENABLED=false
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_FROM=whatsapp:+27600162538
# Content Template SIDs from Twilio Content Template Builder (approved by Meta).
# Leave unset to fall back to freeform text (sandbox/dev only).
TWILIO_TEMPLATE_BOOKING_ASSIGNED_SID=
TWILIO_TEMPLATE_PAYMENT_RECEIVED_SID=

# Chatbot
ANTHROPIC_API_KEY=your_anthropic_api_key
